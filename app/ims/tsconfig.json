{
  "compilerOptions": {
    "target": "ES5",
    "module": "ES6",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "allowJs": true,
     "strict": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "node",
    "rootDir": "./webapp",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "ims/*": [
        "./webapp/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@sapui5/types",
      "../../node_modules/@types",
      "../../node_modules/@sapui5/types"
    ]
  },
  "include": [
    "./webapp/**/*"
  ]
}
