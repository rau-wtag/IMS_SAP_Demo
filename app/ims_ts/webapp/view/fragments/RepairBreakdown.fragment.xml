<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <ResponsivePopover id="_IDGenResponsivePopover2" title="Active Repair Estimates" contentWidth="450px" placement="Bottom">
        <content>
            <Table id="repairBreakdownTable" items="{/MaintenanceAlerts}">
                <columns>
                    <Column id="_IDGenColumn40" width="60%"><Text id="_IDGenText72" text="Asset Model" /></Column>
                    <Column id="_IDGenColumn41" hAlign="End"><Text id="_IDGenText73" text="Est. Cost" /></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem13">
                        <cells>
                            <VBox id="_IDGenVBox5">
                                <Text id="_IDGenText74" text="{code}" />
                                <Text id="_IDGenText75" text="By: {reportedBy}" />
                            </VBox>
                            <ObjectNumber id="_IDGenObjectNumber3" 
                                number="{path: 'estRepairCost', type: 'sap.ui.model.type.Float'}" 
                                unit="BDT" 
                                state="Warning" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>