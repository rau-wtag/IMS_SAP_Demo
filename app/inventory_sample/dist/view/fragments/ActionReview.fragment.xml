<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog id="actionReviewDialog" title="{actionContext>/title}" contentWidth="500px">
        <content>
            <List id="_IDGenList" items="{actionContext>/items}" noDataText="No items selected">
                <StandardListItem id="_IDGenStandardListItem1" 
                    title="{actionContext>name}" 
                    description="{actionContext>code}" 
                    icon="sap-icon://product"
                    
                    press=".onRemoveItemFromAction" />
            </List>
            <f:SimpleForm id="_IDGenSimpleForm4" editable="true" layout="ResponsiveGridLayout">
                <Label id="_IDGenLabel15" text="Reason / Details" required="true" />
                <TextArea id="actionCause" rows="3" placeholder="Explain why you are returning/repairing these items..." />
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button id="_IDGenButton14" text="Confirm" type="Emphasized" press=".onConfirmAction" enabled="{= ${actionContext>/count} > 0}" />
        </beginButton>
        <endButton>
            <Button id="_IDGenButton23" text="Cancel" press=".onCloseActionDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>