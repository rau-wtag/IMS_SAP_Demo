<mvc:View
    controllerName="inventorysample.controller.ProductObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
>
    <uxap:ObjectPageLayout id="ObjectPageLayout">
        <uxap:headerTitle>
            <uxap:ObjectPageHeader
                id="_IDGenObjectPageHeader1"
                objectTitle="{name}"
                objectSubtitle="{unit_type}"
            >
                <uxap:actions>
                    <Button
                        id="_IDGenButton4"
                        icon="sap-icon://add"
                        text="Add New Assets"
                        type="Emphasized"
                        visible="{security>/isAdmin}"
                        press=".onOpenAddSerialsDialog"
                    />

                    <Button
                        id="_IDGenButton15"
                        text="Edit"
                        type="Emphasized"
                        press=".onEditPress"
                        visible="{= ${security>/isAdmin} &amp;&amp; !${ui>/isEditMode} }"
                    />
                    <Button
                        id="_IDGenButton16"
                        text="Delete"
                        type="Reject"
                        press=".onDeletePress"
                        visible="{= ${security>/isAdmin} &amp;&amp; !${ui>/isEditMode} }"
                    />

                    <Button
                        id="_IDGenButton17"
                        text="Save"
                        type="Accept"
                        press=".onSavePress"
                        visible="{ui>/isEditMode}"
                    />
                    <Button
                        id="_IDGenButton18"
                        text="Cancel"
                        press=".onCancelPress"
                        visible="{ui>/isEditMode}"
                    />
                </uxap:actions>
            </uxap:ObjectPageHeader>
        </uxap:headerTitle>

        <uxap:headerContent>
        <HBox id="headerWrapper" width="100%" justifyContent="SpaceBetween" alignItems="Start">
        <VBox id="LEFTdATAstACK" height="210px" justifyContent="SpaceBetween" >
            <HBox id="infoSection" >
            <layout:VerticalLayout id="_IDGenVerticalLayout1" class="sapUiLargeMarginEnd">
                <Label id="_IDGenLabel8" text="Product Name" />
                <Input id="_IDGenInput2"
                    value="{name}"
                    visible="{ui>/isEditMode}"
                    width="300px"
                />
                <Title id="_IDGenTitle5"
                    text="{name}"
                    visible="{= !${ui>/isEditMode} }"
                />

                <Label id="_IDGenLabel9" text="Base Price" />
                <HBox id="_IDGenHBox1" alignItems="Center">
                    <Input id="_IDGenInput3"
                        value="{unit_price}"
                        type="Number"
                        visible="{ui>/isEditMode}"
                        width="150px"
                    />
                    <ObjectNumber id="_IDGenObjectNumber1"
                        number="{unit_price}"
                        unit="BDT"
                        visible="{= !${ui>/isEditMode} }"
                    />
                </HBox>
            </layout:VerticalLayout>

            <layout:VerticalLayout id="_IDGenVerticalLayout2" >
                <Label id="_IDGenLabel10" text="Description" />
                <TextArea id="_IDGenTextArea"
                    value="{description}"
                    visible="{ui>/isEditMode}"
                    width="400px"
                    rows="3"
                />
                <Text id="_IDGenText18"
                    text="{description}"
                    visible="{= !${ui>/isEditMode} }"
                />

                <Label id="_IDGenLabel9a" text="Reorder Level" />
                <HBox id="_IDGenHBox1a" alignItems="Center">
                    <Input id="_IDGenInput3a"
                        value="{reorder_level}"
                        type="Number"
                        visible="{ui>/isEditMode}"
                        width="150px"
                    />
                    <ObjectNumber id="_IDGenObjectNumber1a"
                        number="{reorder_level}"
                        unit="unit(s)"
                        visible="{= !${ui>/isEditMode} }"
                    />
                </HBox>
            </layout:VerticalLayout>
            </HBox>
            

            <HBox id="kpiSection" justifyContent="Start" class="sapUiLargeMarginTop" >
                <layout:VerticalLayout id="_IDGenVerticalLayout3" class="sapUiLargeMarginEnd" >
                    <Label id="_IDGenLabel17" text="TOTAL ITEMS" design="Bold" />
                    <Title id="_IDGenTitle11" text="{valueModel>/totalCount}" titleStyle="H1" class="sapUiTinyMarginTop" />
                </layout:VerticalLayout>

                <layout:VerticalLayout id="_IDGenVerticalLayout4" >
                    <Label id="_IDGenLabel18" text="TOTAL REVENUE" design="Bold" />
                    <Title id="_IDGenTitle12" text="{path: 'valueModel>/totalRevenue', formatter: '.formatCurrencyK'}" titleStyle="H1" class="sapUiTinyMarginTop" />
                    <Text id="_IDGenText70" text="BDT" />
                </layout:VerticalLayout>
            </HBox>

            </VBox>
            
            <VBox id="chartSection" height="auto" alignItems="End" justifyContent="Start">
                <layout:FixFlex id="_IDGenFixFlex22" minFlexSize="240">
                        <layout:flexContent>
                            <viz:VizFrame id="idProductValueChart" vizType="stacked_column" height="100%">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset id="_IDGenFlattenedDataset22" data="{valueModel>/data}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition id="_IDGenDimensionDefinition22" name="Status" value="{valueModel>status}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition2" name="Total Value" value="{valueModel>totalValue}" />
                                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition3" name="Asset Count" value="{valueModel>count}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem id="_IDGenFeedItem2" uid="valueAxis" type="Measure" values="Total Value" />
                                    <viz.feeds:FeedItem id="_IDGenFeedItem32" uid="categoryAxis" type="Dimension" values="Status" />
                                    <viz.feeds:FeedItem id="feedColor" uid="color" type="Dimension" values="Status" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </layout:flexContent>
                    </layout:FixFlex>
                </VBox>
            </HBox>
            
        </uxap:headerContent>

        <uxap:sections>
        <uxap:ObjectPageSection id="_IDGenObjectPageSection3" title="Asset Value Analysis">
            <uxap:subSections>
                <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection3">
                    <!-- <layout:FixFlex id="_IDGenFixFlex22" minFlexSize="400">
                        <layout:flexContent>
                            <viz:VizFrame id="idProductValueChart" vizType="stacked_column" width="100%" height="100%">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset id="_IDGenFlattenedDataset22" data="{valueModel>/data}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition id="_IDGenDimensionDefinition22" name="Status" value="{valueModel>status}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition2" name="Total Value" value="{valueModel>totalValue}" />
                                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition3" name="Asset Count" value="{valueModel>count}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem id="_IDGenFeedItem2" uid="valueAxis" type="Measure" values="Total Value" />
                                    <viz.feeds:FeedItem id="_IDGenFeedItem32" uid="categoryAxis" type="Dimension" values="Status" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </layout:flexContent>
                    </layout:FixFlex> -->
                </uxap:ObjectPageSubSection>
            </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="_IDGenObjectPageSection"
                title="Available Assets"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection">
                        <Table
                            id="availableTable"
                            mode='MultiSelect'
                            selectionChange=".onAssetSelectionChange"
                            items="{path: 'items', parameters: {$select: 'ID,code,status'}}"
                        >
                        <headerToolbar>
                            <OverflowToolbar id="_IDGenOverflowToolbar3">
                                <ToolbarSpacer id="_IDGenToolbarSpacer4" />
                                <Button id="addToCartBtn" text="Add to Cart" icon="sap-icon://cart-add" 
                                        enabled="false" press=".onAddToCart" type="Emphasized" />

                            </OverflowToolbar>
                        </headerToolbar>
                            <columns>
                                <Column id="_IDGenColumn2">
                                    <Text
                                        id="_IDGenText2"
                                        text="Serial Number"
                                    />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem1">
                                    <cells>
                                        <Text
                                            id="_IDGenText6"
                                            text="{code}"
                                        />
                                        
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection id="requestedAssetsSection" title="Assets Requiring Action">
    <uxap:subSections>
        <uxap:ObjectPageSubSection id="requestedAssetsSubSection">
            <Table
                id="requestedTable"
                items="{
                    path: '/RequestItems',
                    parameters: {
                        $expand: {
                            'product': {
                                '$select': 'code,status',
                                '$expand': 'details($select=name)'
                            },
                            'parent': {
                                '$expand': 'requestedBy($select=name)',
                                '$select': 'type'
                            }
                        }
                    }
                    
                }"
            >
                <columns>
                    <Column id="colReqCode">
                        <Text id="_IDGenText35" text="Asset Code" />
                    </Column>
                    <Column id="colRequester">
                        <Text id="_IDGenText36" text="Requested By" />
                    </Column>
                    <Column id="colRequestAction">
                        <Text id="_IDGenText36a" text="Requested Action" />
                    </Column>
                    <Column id="colReqDate">
                        <Text id="_IDGenText37" text="Status" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="itemReqRow">
                        <cells>
                            <Text id="_IDGenText38" text="{product/code}" />
                            <Text id="_IDGenText39" text="{parent/requestedBy/name}" />
                            <Text id="_IDGenText39a" text="{parent/type}" />
                            <ObjectStatus id="_IDGenObjectStatus5"
                                text="Pending Approval"
                                state="Warning"
                                icon="sap-icon://pull-request"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </uxap:ObjectPageSubSection>
    </uxap:subSections>
</uxap:ObjectPageSection>

            <uxap:ObjectPageSection
                id="_IDGenObjectPageSection1"
                title="Currently In Use"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection1">
                        <Table
                            id="inUseTable"
                            items="{path: 'items', 
                                    parameters: {
                                        $select: 'ID,code,status',
                                        $expand: 'currentPossession($select=ID,name)'
                                    
                                    }
                                }"
                        >
                            <columns>
                                <Column id="_IDGenColumn5">
                                    <Text
                                        id="_IDGenText7"
                                        text="Asset Code"
                                    />
                                </Column>
                                <Column id="_IDGenColumn23">
                                    <Text id="_IDGenText11"
                                       
                                        text="Current User"
                                    />
                                </Column>
                                <Column id="_IDGenColumn7">
                                    <Text
                                        id="_IDGenText9"
                                        text="Status"
                                    />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem2">
                                    <cells>
                                        <Text
                                            id="_IDGenText10"
                                            text="{code}"
                                        />
                                        <Text 
                                            id="_IDGenText34"
                                            text="{currentPossession/name}"
                                        />
                                        <ObjectStatus
                                            id="_IDGenObjectStatus"
                                            text="In Use"
                                            state="Information"
                                            icon="sap-icon://employee"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection
                id="_IDGenObjectPageSection2"
                title="Under Repair"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection2">
                        <Table
                            id="repairTable"
                            items="{path: 'items', 
                                    parameters: {
                                        $select: 'ID,code,status',
                                        $expand: 'currentPossession($select=ID,name)'
                                    
                                    }
                                }"
                        >
                            <columns>
                                <Column id="_IDGenColumn8">
                                    <Text
                                        id="_IDGenText12"
                                        text="Asset Code"
                                    />
                                </Column>
                                <Column id="_IDGenColumn9">
                                    <Text
                                        id="_IDGenText13"
                                        text="Condition"
                                    />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem3">
                                    <cells>
                                        <Text
                                            id="_IDGenText14"
                                            text="{code}"
                                        />
                                        <Text 
                                            id="_IDGenText34a"
                                            text="{currentPossession/name}"
                                        />
                                        <ObjectStatus
                                            id="_IDGenObjectStatus1"
                                            text="Repairing"
                                            state="Error"
                                            icon="sap-icon://tools-opportunity"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
