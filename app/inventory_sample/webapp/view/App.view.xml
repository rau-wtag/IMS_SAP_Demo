<mvc:View controllerName="inventorysample.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    displayBlock="true">
    <Bar id="_IDGenBar12" visible="{isLogin>/isLoggedIn}">
        <contentLeft>
            <Title id="_IDGenTitle9" text="Inventory Suite" titleStyle="H5" class="sapUiSmallMarginBegin" />
        </contentLeft>
        <contentRight>
            <Button id="_IDGenButton20" 
                icon="sap-icon://cart" 
                text="Cart ({cart>/count})"
                type="Transparent"
                press=".onOpenCart" />
            <Button id="_IDGenButton20a" icon="sap-icon://log" type="Transparent"  press=".onLogout" />
        </contentRight>
    </Bar>
    <App id="app">        
    </App>
    
  
</mvc:View>