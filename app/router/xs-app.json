{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/app-logout",
    "logoutPage": "/"
  },
  "routes": [
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "localDir": "../inventory_sample/webapp",
      "authenticationType": "xsuaa"
    }
  ]
}
