{
  "name": "sample",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-inventory_sample": "cds watch --open inventorysample/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy sample --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-inventory_list": "cds watch --open inventorylist/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "strategy": "mock",
          "users": {
            "ramisa@example.com": {
              "password": "123",
              "roles": [
                "Admin_Role", 
                "authenticated-user"
              ]
            },
            "orpa@example.com": {
              "password": "123",
              "roles": [
                "Employee_Role",
                "authenticated-user"
              ]
            },
            "huma@example.com": {
              "password": "123",
              "roles": [
                "Employee_Role",
                "authenticated-user"
              ]
            },
            "raiyan@example.com": {
              "password": "123",
              "roles": [
              
              ]
            },
            "*": false
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        },
        "schema_evolution": "auto"
      },
      "[production]": {
        "auth": "mocked",
        "db": {
          "kind": "hana"
        },
        "destinations": true,
        "html5-repo": true
      },
      "workzone": true
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/inventory_list"
  ]
}
