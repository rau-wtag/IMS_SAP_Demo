{
  "xsappname": "sample-inventory-app",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin Scope"
    },
    {
      "name": "$XSAPPNAME.Employee",
      "description": "Employee scope"
    },
    {
      "name": "$XSAPPNAME.Admin_Role",
      "description": "Admin_Role"
    },
    {
      "name": "$XSAPPNAME.Employee_Role",
      "description": "Employee_Role"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Admin_Role",
      "description": "Admin role",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "Employee_Role",
      "description": "Employee role",
      "scope-references": [
        "$XSAPPNAME.Employee"
      ]
    }
  ],
  "authorities-inheritance": false,
  "oauth2-configuration": {
    "credential-types": [
      "binding-secret",
      "x509"
    ],
    "redirect-uris": [
      "https://*.us10-001.hana.ondemand.com/**",
      "https://*.us10.hana.ondemand.com/**",
      "http://localhost:5000/login/callback"
    ]
  }
}
